<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The media notification is a foreground service; API 34+ wants its type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- wgpu needs Vulkan 1.1 or GLES 3.0; both are optional so older devices install. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false"
        android:version="0x00401000" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:label="Sonora"
        android:supportsRtl="true"
        android:theme="@style/SonoraTheme">

        <activity
            android:name="org.sonora.SonoraActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/SonoraTheme"
            android:windowSoftInputMode="adjustResize">

            <!-- NativeActivity dlopens this library; the name comes from the
                 nativeLibraryName placeholder in app/build.gradle.kts. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="${nativeLibraryName}" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The throwaway browser window cookie sign-ins and PO tokens use. -->
        <activity
            android:name="org.sonora.WebViewActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|density"
            android:exported="false"
            android:label="Sonora"
            android:theme="@style/SonoraTheme" />

        <!-- The always-on media notification; its type must be mediaPlayback. -->
        <service
            android:name="org.sonora.SonoraMediaService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
