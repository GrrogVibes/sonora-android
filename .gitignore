# The vendored backends are part of the source: the Android port patches gpui and
# ships gpui-mobile, so a clone has to build without fetching them. Their own
# checkouts (nested .git dirs) and build dirs stay out.
vendor/**/.git/
vendor/**/target/
android/app/src/main/jniLibs/
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/*.apk
android/*.idsig
